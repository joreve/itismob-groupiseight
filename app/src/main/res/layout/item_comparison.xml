<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Adapted.SurfaceCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Aspect Header: Title & Score Chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/txt_aspect_title"
                style="@style/TextAppearance.Adapted.CardTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp"
                tools:text="Plot &amp; Structure" />

            <TextView
                android:id="@+id/txt_aspect_score_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_category_icon"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="90% Match"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Source Detail Box (Primary Highlighted Focus) -->
        <LinearLayout
            android:id="@+id/container_aspect_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_aspect_highlight_primary"
            android:padding="10dp"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/txt_aspect_source_label"
                    style="@style/TextAppearance.Adapted.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    tools:text="BOOK VERSION"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/txt_source_focus_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/comparison_primary_focus_badge"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_aspect_source_detail"
                style="@style/TextAppearance.Adapted.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="Source details here..." />
        </LinearLayout>

        <!-- Target Detail Box (Secondary/Neutral) -->
        <LinearLayout
            android:id="@+id/container_aspect_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_aspect_neutral"
            android:padding="10dp">

            <TextView
                android:id="@+id/txt_aspect_target_label"
                style="@style/TextAppearance.Adapted.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                tools:text="MOVIE VERSION"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/txt_aspect_target_detail"
                style="@style/TextAppearance.Adapted.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                tools:text="Target details here..." />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
