<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/explore_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical"
    tools:context=".activities.ExploreActivity">

    <TextView
        style="@style/TextAppearance.Adapted.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/explore_title" />

    <!-- Search field (the X to clear it is provided by endIconMode="clear_text") -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Adapted.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:hint="@string/explore_search_hint"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/explore_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category filter -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/explore_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Adapted.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/category_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_books"
                style="@style/Widget.Adapted.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_books_plural" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_movies"
                style="@style/Widget.Adapted.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_movies_plural" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tv_series"
                style="@style/Widget.Adapted.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_tv_series" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_music"
                style="@style/Widget.Adapted.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/category_music" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Result count + reset -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/explore_result_count"
            style="@style/TextAppearance.Adapted.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/explore_reset_button"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/explore_reset"
            android:visibility="invisible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/explore_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp" />

        <!-- Shown when no media matches the search / filter -->
        <LinearLayout
            android:id="@+id/explore_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />

            <TextView
                style="@style/TextAppearance.Adapted.SectionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/explore_empty_title" />

            <TextView
                style="@style/TextAppearance.Adapted.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/explore_empty_message" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/explore_empty_reset_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/explore_empty_reset" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
