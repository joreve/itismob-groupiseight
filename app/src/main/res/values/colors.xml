<?xml version="1.0" encoding="utf-8"?>
<!--
    Temporary black-and-white palette. To re-brand the app, change these values (and the
    mapping in themes.xml). Layouts should use theme attributes (?attr/...) instead of these
    names directly.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Light gray: cards, secondary backgrounds -->
    <color name="gray_light">#FFF3F3F3</color>
    <!-- Light gray: borders and dividers -->
    <color name="gray_border">#FFDCDCDC</color>
    <!-- Medium gray: input outlines -->
    <color name="gray_outline">#FF9A9A9A</color>
    <!-- Dark gray: secondary text -->
    <color name="gray_dark">#FF5C5C5C</color>
</resources>
